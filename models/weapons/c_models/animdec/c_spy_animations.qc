	activity "ACT_ITEM1_VM_INSPECT_IDLE" 2
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
}

$sequence "item1_inspect_idle_B" {
	"c_spy_animations_anims\item1_inspect_idle_B.smd"
	activity "ACT_ITEM1_VM_INSPECT_IDLE" 1
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
}

$sequence "item1_inspect_end" {
	"c_spy_animations_anims\item1_inspect_end.smd"
	activity "ACT_ITEM1_VM_INSPECT_END" 1
	{ event 5004 1 "WeaponInspect.Movement2" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "building_inspect_start" {
	"c_spy_animations_anims\building_inspect_start.smd"
	activity "ACT_BUILDING_VM_INSPECT_START" 1
	{ event 5004 4 "MeleeInspect.Movement" }
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "building_inspect_idle" {
	"c_spy_animations_anims\building_inspect_idle.smd"
	activity "ACT_BUILDING_VM_INSPECT_IDLE" 1
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
}

$sequence "building_inspect_end" {
	"c_spy_animations_anims\building_inspect_end.smd"
	activity "ACT_BUILDING_VM_INSPECT_END" 1
	{ event 5004 55 "MeleeInspect.Movement" }
	{ event 5004 86 "MeleeInspect.Movement" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "breadsapper_inspect_start" {
	"c_spy_animations_anims\breadsapper_inspect_start.smd"
	activity "ACT_BREADMONSTER_VM_INSPECT_START" 1
	{ event 5004 59 "Weapon_bm_throwable.growl" }
	{ event 5004 11 "MeleeInspect.Movement" }
	{ event 5004 32 "MeleeInspect.Movement" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "breadsapper_inspect_idle" {
	"c_spy_animations_anims\breadsapper_inspect_idle.smd"
	activity "ACT_BREADMONSTER_VM_INSPECT_IDLE" 1
	{ event AE_CL_PLAYSOUND 38 "Weapon_bm_sapper.snap" }
	{ event AE_CL_PLAYSOUND 52 "Weapon_bm_sapper.snap" }
	{ event AE_CL_PLAYSOUND 91 "Weapon_bm_sapper.snap" }
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
}

$sequence "breadsapper_inspect_end" {
	"c_spy_animations_anims\breadsapper_inspect_end.smd"
	activity "ACT_BREADMONSTER_VM_INSPECT_END" 1
	{ event AE_CL_PLAYSOUND 12 "Weapon_bm_sapper.snap" }
	{ event AE_CL_PLAYSOUND 29 "Weapon_bm_sapper.snap" }
	{ event 5004 2 "MeleeInspect.Movement" }
	{ event 5004 38 "MeleeInspect.Movement" }
	fadein 0.2
	fadeout 0.2
	fps 30
}

