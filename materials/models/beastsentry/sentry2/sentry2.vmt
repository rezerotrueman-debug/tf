"VertexLitGeneric"
{
	"$basetexture"	"models\beastsentry\sentry2\Sentry2"
	"$bumpmap" 	"models\beastsentry\sentry2\Sentry2_normal"
	"$phong" "1"
	"$phongboost" "10"
	"$phongexponent" "25"
	"$lightwarptexture" "models\buildables\sentry1\Sentry1_lightwarp"
	"$phongfresnelranges"	"[.5 1.5 10]"
	
	"$selfillum" "1"


	"$rimlight" "1"		
	"$rimlightexponent" "4"				
	"$rimlightboost" "1.5"
	
	"360?$color2" "[ 0.4 0.4 0.4 ]"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}
