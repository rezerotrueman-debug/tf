"UnlitGeneric"
{
"$baseTexture" "models\weapons\w_grenade_heal/bubbles_anim"
	"$surfaceprop"	"default"
	"$envmap" "env_cubemap"
	"$envmaptint" "[1 .8 .5]"
	"$selfillum" 1
	
	"$ambientocclusion" 1
	
//phong properties
	"$phong"	"1"
	"$phongboost"	"1"
	"$phongexponent"	"20"
	"$phongfresnelranges"	"[.5 1 2]"
	"Proxies"
		{
			"AnimatedTexture"
			{
				"animatedtexturevar" "$basetexture"
				"animatedtextureframenumvar" "$frame"
				"animatedtextureframerate" 30
			}
		}
}