"VertexLitGeneric"
{
	"$baseTexture" "models/weapons/v_lightning_gun/lightning_gun_screen"
	"$detail"	"models/weapons/v_lightning_gun/lightning_gun_screen_gradient"
	"$detailscale" "[1 1]"
	"$detailblendfactor" 1	// 0.2 for unlitgeneric
	
	"$model" "1"
//	"$nocull" "1"

	"$selfillum"		"1"
	"$selfillumtint"		"[3 3 3]"
	
	//---------------
	// Visual Effects
	//---------------
	"$cloakPassEnabled" 	"1"

	"Proxies"
	{
		"invis"
		{
		}
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" 0.25
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" -0.5
		}
	}
}