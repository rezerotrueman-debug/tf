"VertexlitGeneric"
{
	"$baseTexture" "models/weapons/spy/flintlock/flintlock"
	"$bumpmap" "models/weapons/spy/flintlock/flintlock_normal"
	"$halflambert" "1"

	"$envmap" "env_cubemap"
	
	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost" ".3"	
	"$lightwarptexture" "models/weapons/c_items/c_ambassador_lightwarp"
	"$phongfresnelranges"	"[1 2 10]"
	"$cloakPassEnabled" "1"
	
	"Proxies"
	{
		"vm_invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
	}
}
