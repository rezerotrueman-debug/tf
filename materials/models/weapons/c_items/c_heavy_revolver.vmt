"VertexlitGeneric"
{
	/////////////////////////////////////////////////////
	//					texture.
	/////////////////////////////////////////////////////
	$basetexture "models\weapons\c_items\c_heavy_revolver.vtf"
	$model 1

	//$alpha 1.0
	//$transluscent 1

	/////////////////////////////////////////////////////
	//					phong.
	/////////////////////////////////////////////////////
	$phong 1
	$phongexponent 10
	$phongboost 0.75
	$phongfresnelranges	"[1.0 0.5 2.0]"

	//$lightwarptexture "models/player/pyro/pyro_lightwarp"		//player light warp
	//$lightwarptexture "models\lightwarps\weapon_lightwarp"		//weapon light warp
	$halflambert 1
	$lightwarptexture "models\weapons\c_items/c_ambassador_lightwarp"

	$basemapalphaphongmask 1

	/////////////////////////////////////////////////////
	//					rim lighting.
	/////////////////////////////////////////////////////
	$rimlight 1
	$rimlightexponent 20
	$rimlightboost 2

	/////////////////////////////////////////////////////
	//					paint section.	
	/////////////////////////////////////////////////////
	//$BlendTintByBaseAlpha 1
	//$BlendTintColorOverBase 1.0

	//$colortint_base "{255 150 100}"
	//$colortint_tmp "[0 0 0]"

	/////////////////////////////////////////////////////
	//			extra effects(fire, jarate, glow).
	/////////////////////////////////////////////////////
	$yellow 0

	$glowcolor 1

	/////////////////////////////////////////////////////
	//					cloaking.
	/////////////////////////////////////////////////////
	$cloakPassEnabled 1

	/////////////////////////////////////////////////////
	//					weapon sheen.
	/////////////////////////////////////////////////////
	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	/////////////////////////////////////////////////////
	//					Proxies.
	/////////////////////////////////////////////////////
	"Proxies"
	{
		"weapon_invis"
		{
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}
