"VertexlitGeneric"
{
	"$basetexture" "vgui/models/weapons/c_items/c_knife"
	"$bumpmap" "models/effects/flat_normal"
	"$basemapalphaphongmask" "1"

	// Based off of the thunder texture
	"$phong" "1"
	"$phongexponent" "25"
	"$phongboost" "10"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"
	"$rimlight" "1"
	"$rimlightexponent" "4"	
	"$rimlightboost" "1"
	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"weapon_invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
	}
}

