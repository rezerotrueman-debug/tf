"VertexlitGeneric"
{
	/////////////////////////////////////////////////////
	//					texture.
	/////////////////////////////////////////////////////
	$basetexture "models\weapons\c_items\c_heavy_revolver_misc.vtf"
	$model 1

	$nocull 1
	
	$alphatest 1.0
	//$transluscent 1

	/////////////////////////////////////////////////////
	//					phong.
	/////////////////////////////////////////////////////
	$phong 1
	$phongexponent 5
	$phongboost 0.5
	$phongfresnelranges "[0.5 0.75 1]"

	//$lightwarptexture "models/player/pyro/pyro_lightwarp"		//player light warp
	$lightwarptexture "models\lightwarps\weapon_lightwarp"		//weapon light warp
	$halflambert 1

	//$BaseMapAlphaPhongMask 1

	/////////////////////////////////////////////////////
	//					rim lighting.
	/////////////////////////////////////////////////////
	$rimlight 1
	$rimlightexponent 15
	$rimlightboost 0.75

	/////////////////////////////////////////////////////
	//					paint section.	
	/////////////////////////////////////////////////////
	//$BlendTintByBaseAlpha 1
	//$BlendTintColorOverBase 1.0

	//$colortint_base "{255 150 100}"
	//$colortint_tmp "[0 0 0]"

	/////////////////////////////////////////////////////
	//			extra effects(fire, jarate, glow).
	/////////////////////////////////////////////////////
	$detail "effects/tiledfire/fireLayeredSlowTiled512.vtf"
	$detailscale 5.0
	$detailblendfactor 0.0
	$detailblendmode 6

	$yellow 0

	$glowcolor 1

	/////////////////////////////////////////////////////
	//					cloaking.
	/////////////////////////////////////////////////////
	$cloakPassEnabled 1

	/////////////////////////////////////////////////////
	//					Proxies.
	/////////////////////////////////////////////////////
	"Proxies"
	{
		"weapon_invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1"  "$yellow"
			"resultVar" "$color2"
		}
  		"ItemTintColor"
  		{
   			"resultVar" "$colortint_tmp"
  		}
		"SelectFirstIfNonZero"
  		{
   			"srcVar1" "$colortint_tmp"
   			"srcVar2" "$colortint_base"
   			"resultVar" "$color2"
  		}
	}
}
